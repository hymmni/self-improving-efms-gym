# cp .env.example .env 후 값을 채우세요. .env는 git에 커밋되지 않습니다.
WANDB_API_KEY=
# X11 GUI(텔레옵/mjviewer)를 쓸 때만 필요. 보통 호스트 값과 동일하게 :0 또는 :1
DISPLAY=:0
# `id -u`, `id -g`로 확인한 본인 값으로 채우세요. 컨테이너가 root 대신 이 UID/GID로 돌아서
# 마운트된 ~/.claude, /workspace에 host 소유로 정확히 파일을 씀 (root 오염 방지, DOCKER.md 참고)
# (이름을 UID/GID로 안 한 이유: 일부 셸(zsh 등)이 UID를 자체적으로 export해서 .env 값을 덮어씀)
DOCKER_UID=1000
DOCKER_GID=1000
