__pycache__/
*.py[cod]

# Docker 환경변수 (WandB API 키 등)
.env

# Harness — CLAUDE.md, docs/(private/ 제외), scripts/, .claude/skills/는 git 추적,
# 나머지 하네스 파일은 로컬 전용.
# 앞에 '/'를 붙여 레포 루트에만 적용시킨다 — 앵커 없이 'docs/'처럼 두면 square_assembly/docs/,
# square_assembly/src/square_assembly/scripts/ 같은 서브프로젝트 내부의 같은 이름 디렉토리까지 전부
# 무시돼버린다(square_assembly 통합 때 실제로 발견됨: square_assembly의 scripts/train.py가 이 규칙 때문에
# 조용히 추적 안 될 뻔했다).
/.claude/*
!/.claude/skills/
/docs/private/
/experiments/
/phases/
/references/
continuation_plan.md

# 대용량 데이터/체크포인트 (ADR-002)
*.zarr
*.hdf5
*.pth
checkpoints/

